<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:li="clr-namespace:Karamem0.Capreze.Interactivity"
    xmlns:properties="clr-namespace:Karamem0.Capreze.Properties"
    x:Class="Karamem0.Capreze.Views.AboutWindow"
    x:Name="Window"
    mc:Ignorable="d"
    Height="160"
    Icon="/App.png"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Width="320"
    WindowStartupLocation="CenterOwner">
    <Window.Background>
        <x:Static Member="SystemColors.ControlBrush" />
    </Window.Background>
    <Window.Title>
        <x:Static Member="properties:Resources.AboutWindowTitle" />
    </Window.Title>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid
            Grid.Column="0"
            Grid.Row="0"
            Margin="6,6,6,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Image
                Grid.Column="0"
                Grid.Row="0"
                Height="48"
                Source="/App.png"
                Width="48" />
            <StackPanel
                Grid.Column="1"
                Grid.Row="0"
                Margin="6,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock>
                        <TextBlock.Text>
                            <Binding Path="Product" />
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text=" " />
                    <TextBlock>
                        <TextBlock.Text>
                            <Binding Path="Version" />
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
                <TextBlock>
                    <TextBlock.Text>
                        <Binding Path="Company" />
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock>
                    <TextBlock.Text>
                        <Binding Path="Copyright" />
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>
        </Grid>
        <StackPanel
            Grid.Column="0"
            Grid.Row="1"
            Margin="6,6,6,6"
            Orientation="Horizontal"
            HorizontalAlignment="Right">
            <Button
                Margin="3,3,3,3"
                Padding="3,3,3,3"
                Width="96">
                <Button.Content>
                    <x:Static Member="properties:Resources.OkButtonContent" />
                </Button.Content>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Click">
                        <i:CallMethodAction MethodName="Close">
                            <i:CallMethodAction.TargetObject>
                                <Binding ElementName="Window" />
                            </i:CallMethodAction.TargetObject>
                        </i:CallMethodAction>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Button>
        </StackPanel>
    </Grid>
</Window>
