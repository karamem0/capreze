<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:system="clr-namespace:System;assembly=System"
    xmlns:li="clr-namespace:Karamem0.Capreze.Interactivity"
    xmlns:properties="clr-namespace:Karamem0.Capreze.Properties"
    x:Class="Karamem0.Capreze.Views.AboutWindow"
    x:Name="Window"
    mc:Ignorable="d"
    Height="200"
    Icon="/Icons/App.png"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Width="320"
    WindowStartupLocation="CenterOwner">
    <Window.Background>
        <x:Static Member="SystemColors.ControlBrush" />
    </Window.Background>
    <Window.Title>
        <x:Static Member="properties:Resources.AboutWindowTitle" />
    </Window.Title>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.Background>
                <x:Static Member="SystemColors.ControlLightLightBrush" />
            </Grid.Background>
            <Grid
                Grid.Column="0"
                Grid.Row="0"
                Margin="6,6,6,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel
                    Grid.Column="0"
                    Grid.Row="0"
                    Grid.RowSpan="2">
                    <Image
                        Height="48"
                        Source="/Icons/App.png"
                        Width="48" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    Grid.Row="0"
                    Margin="6,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock>
                            <TextBlock.Text>
                                <Binding Path="Product" />
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Text=" " />
                        <TextBlock>
                            <TextBlock.Text>
                                <Binding Path="Version" />
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock>
                        <TextBlock.Text>
                            <Binding Path="Company" />
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock>
                        <TextBlock.Text>
                            <Binding Path="Copyright" />
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    Grid.Row="1"
                    Margin="6,6,0,0">
                    <TextBlock>
                        <Hyperlink NavigateUri="https://www.flaticon.com/free-icons/error">
                            <i:Interaction.Behaviors>
                                <li:EventToCommandBehavior EventName="Click">
                                    <li:EventToCommandBehavior.Command>
                                        <Binding Path="OpenUriCommand" />
                                    </li:EventToCommandBehavior.Command>
                                    <li:EventToCommandBehavior.CommandParameter>
                                        <system:Uri>https://www.flaticon.com/free-icons/error</system:Uri>
                                    </li:EventToCommandBehavior.CommandParameter>
                                </li:EventToCommandBehavior>
                            </i:Interaction.Behaviors>
                            <Run Text="Error icons created by juicy_fish - Flaticon" />
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>
        <StackPanel
            Grid.Column="0"
            Grid.Row="2"
            Margin="6,6,6,6"
            Orientation="Horizontal"
            HorizontalAlignment="Right">
            <Button
                Margin="3,3,3,3"
                Padding="3,3,3,3"
                Width="96">
                <Button.Content>
                    <x:Static Member="properties:Resources.OkButtonContent" />
                </Button.Content>
                <i:Interaction.Behaviors>
                    <li:EventToCommandBehavior EventName="Click">
                        <li:EventToCommandBehavior.Command>
                            <Binding Path="CloseCommand" />
                        </li:EventToCommandBehavior.Command>
                        <li:EventToCommandBehavior.CommandParameter>
                            <system:Boolean>true</system:Boolean>
                        </li:EventToCommandBehavior.CommandParameter>
                    </li:EventToCommandBehavior>
                </i:Interaction.Behaviors>
            </Button>
        </StackPanel>
    </Grid>
    <i:Interaction.Behaviors>
        <li:ViewModelBehavior />
    </i:Interaction.Behaviors>
    <i:Interaction.Triggers>
        <li:InteractionRequestTrigger Name="Close">
            <li:InteractionRequestTrigger.SourceObject>
                <Binding Path="InteractionRequest" />
            </li:InteractionRequestTrigger.SourceObject>
            <li:CloseDialogAction />
        </li:InteractionRequestTrigger>
    </i:Interaction.Triggers>
</Window>
